{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "device": {
      "developmentClient": false,
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      }
    },
    "unsigned-ipa": {
      "extends": "preview",
      "channel": "preview",
      "ios": {
        "simulator": false,
        "config": "unsigned-ipa.yml"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      }
    },
    "testflight": {
      "channel": "preview",
      "autoIncrement": true,
      "credentialsSource": "local",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {},
    "testflight": {
      "ios": {
        "ascApiKeyPath": "./credentials/asc-api-key.p8",
        "ascApiKeyId": "4ZR5S4Q694",
        "ascApiKeyIssuerId": "f8769ad5-5ffd-49be-9b53-a5071535fa8c"
      }
    }
  }
}
